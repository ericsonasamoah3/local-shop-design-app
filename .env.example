# docker-compose reads variables from a .env file in this same directory
# (repo root) automatically. Copy this to .env and fill in real values.
# Never commit .env itself.

# OPTIONAL. Leave empty to run without Claude.
#
# Note this is the Claude API, billed per token — a Claude Pro/Max subscription
# does NOT cover it and cannot be used from an app.
#
# With a key, Claude plans each composite: it refines the area to regenerate,
# writes the prompt from what it can actually see in the room, and vetoes
# placements that make no sense before you pay for a generation.
# Without one, the backend uses the rectangle the user drew and a template
# prompt built from catalogue fields. Everything still works.
ANTHROPIC_API_KEY=

# From replicate.com/account/api-tokens. The diffusion model does the pixels.
REPLICATE_API_TOKEN=

# The model VERSION HASH (not the model name) of a mask + reference-image
# inpainting model. Version hashes change over time, so take the current one
# from the model's Replicate page rather than trusting any value written in
# code or docs. See backend/.env.example for the input field mapping.
REPLICATE_MODEL_VERSION=

# Spend cap on the unauthenticated /api/composite endpoint.
# Defaults to 20 composites per client per hour; 0 disables it locally.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=3600000
