# Copy this file to .env and fill in real values. Never commit .env itself.

# From replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# The specific model VERSION HASH (not just the model name) from whichever
# Replicate model you choose. Model versions change over time — get the
# current one from the model's page on replicate.com right before use,
# rather than trusting any hash written in code/docs.
#
# Prefer a model that supports image-conditioned/reference input
# (IP-Adapter-style inpainting) over plain text-prompt inpainting — this
# preserves the real product's actual appearance rather than generating a
# generic reinterpretation of it. Check the model's own input schema on its
# Replicate page, since field names (e.g. "ip_adapter_image") vary by model
# and compositeService.js may need small adjustments to match.
REPLICATE_MODEL_VERSION=
