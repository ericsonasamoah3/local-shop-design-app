# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Claude: plans the composite (OPTIONAL) --------------------------------
# From console.anthropic.com. Billed per token; a Claude Pro/Max subscription
# does NOT cover API usage and cannot be used from an app.
#
# Leave EMPTY to run without Claude. The backend then uses the rectangle the
# user drew plus a template prompt from catalogue fields -- no scene awareness
# and no plausibility gate, but no per-composite model cost either.
#
# With a key, Claude sees the room photo, the product photo and the drawn box,
# and returns a plan: the area to regenerate, the prompt, and a plausibility
# flag that stops doomed requests before you pay to render them.
ANTHROPIC_API_KEY=

# Which Claude model plans the composite. Roughly per composite:
#   claude-opus-5   ~$0.06   strongest judgement (default)
#   claude-sonnet-5 ~$0.026
#   claude-haiku-4-5 ~$0.013  bounded task, usually plenty
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Replicate: renders the composite --------------------------------------
REPLICATE_API_TOKEN=

# Which model to run. Two accepted forms, and the right endpoint is chosen from
# the shape of what you put here:
#
#   owner/name        an official hosted model, e.g. black-forest-labs/flux-fill-pro
#                     (these have no public version hash)
#   64-hex hash       a pinned community model version
#
# Version hashes change over time. Get the current one from the model's page on
# replicate.com right before use; do not trust a hash written in code or docs:
#   curl -s -H "Authorization: Bearer $REPLICATE_API_TOKEN" #     https://api.replicate.com/v1/models/OWNER/NAME | jq -r .latest_version.id
#
# Recommended starting point while catalogue images are still placeholders:
#   REPLICATE_MODEL_VERSION=black-forest-labs/flux-fill-pro
#   REPLICATE_FIELD_NEGATIVE_PROMPT=
#   REPLICATE_FIELD_REFERENCE=
REPLICATE_MODEL_VERSION=

# Input field names differ between inpainting models — one model's
# `ip_adapter_image` is another's `image_prompt` or `reference_image`. Check the
# schema on your model's Replicate page and override any that do not match.
#
# Setting one to an EMPTY value omits that field entirely. Replicate rejects a
# request containing any input it does not declare, so this is how you adapt to
# a model with a smaller schema.
#
# Defaults (a mask + reference model):
# REPLICATE_FIELD_IMAGE=image
# REPLICATE_FIELD_MASK=mask
# REPLICATE_FIELD_PROMPT=prompt
# REPLICATE_FIELD_NEGATIVE_PROMPT=negative_prompt
# REPLICATE_FIELD_REFERENCE=ip_adapter_image
# REPLICATE_FIELD_REFERENCE_STRENGTH=ip_adapter_weight
#
# For a MASK-ONLY model such as black-forest-labs/flux-fill-pro, blank the two
# fields it does not accept. Note that with no reference field the model never
# sees the product photo, so the item is generated from Claude's description
# rather than being the real catalogue item:
# REPLICATE_FIELD_NEGATIVE_PROMPT=
# REPLICATE_FIELD_REFERENCE=

# --- Cost -------------------------------------------------------------------
# Long edge the room photo is capped at before rendering. Generation cost and
# latency scale with pixel count, so this is the biggest knob on what a
# composite costs. Raise it for quality, lower it for cheaper previews.
# MAX_RENDER_EDGE=1024

# --- Spend cap ---------------------------------------------------------------
# /api/composite has no auth in front of it and spends Anthropic and Replicate
# credits on every call, so POSTs to it are rate limited per client.
# Defaults: 20 requests per hour. Set RATE_LIMIT_MAX=0 to disable while testing
# locally. Counters are in-memory, so they reset on restart and do not work
# across instances -- a spend cap, not a security control.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=3600000

# --- Catalogue ---------------------------------------------------------------
# Where the ingested catalogue is read from. Defaults to backend/catalog/
# catalog.json, which ships inside the image -- keep that file committed or the
# deployed app silently falls back to the placeholder seed. Point this
# elsewhere only if you need to re-ingest without rebuilding.
# CATALOG_PATH=
